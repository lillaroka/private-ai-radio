# DeepSeek (script generation + feedback summarization)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_SCRIPT_MODEL=deepseek-v4-pro

# OpenRouter (web search only)
OPENROUTER_API_KEY=
OPENROUTER_SEARCH_MODEL=qwen/qwen3.6-plus

# SiliconFlow (TTS)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Search region (defaults to CN)
# Change this to match your location for better search results
SEARCH_COUNTRY=CN

# TTS reference voices (optional — override the built-in demo voices)
# Set these to use custom voice references from URLs or base64 data
MOSS_REFERENCE_S1_AUDIO=
MOSS_REFERENCE_S1_TEXT=
MOSS_REFERENCE_S2_AUDIO=
MOSS_REFERENCE_S2_TEXT=

# Optional
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Private AI Radio
